---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import { getPublications } from '../../lib/publications';
const publications = getPublications();
---
<BaseLayout lang="en" title="Publications | Jumpei Yamagishi" switchPath="/ja/publications/">
  <section>
    <div class="section-header">
      <h2>Publications</h2>
      <div>
        <h1>Publications</h1>
        <p class="intro">This list is generated from <code>src/data/publications.yaml</code>.</p>
      </div>
    </div>
  </section>
  <section>
    <div class="section-header">
      <h2>All</h2>
      <PublicationList publications={publications} lang="en" />
    </div>
  </section>
</BaseLayout>
