---
interface Props { lang: 'en' | 'ja'; }
const { lang } = Astro.props;
const items = lang === 'en'
  ? [
      ['Microeconomics of Metabolism', 'Metabolic systems can be viewed as economic agents.'],
      ['Statistical Physics of Microbial Ecosystems', '']
    ]
  : [
      ['代謝経済学', ''],
      ['微生物生態系の統計物理学', '']
    ];
---
<div class="grid">
  {items.map(([title, body]) => (
    <div class="card">
      <h3>{title}</h3>
      <p>{body}</p>
    </div>
  ))}
</div>
