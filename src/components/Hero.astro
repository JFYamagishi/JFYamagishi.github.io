    <a href={`/${lang}/publications/`}>{lang === 'en' ? 'Publications' : '論文'}</a>
    <a href={`/${lang}/notes/`}>{lang === 'en' ? 'Notes' : 'ノート'}</a>
    <a href={`/${lang}/about/`}>{lang === 'en' ? 'About' : 'プロフィール'}</a> -->
    <a href="mailto:jumpei.yamagishi@riken.jp">{lang === 'en' ? 'Contact' : '連絡先'}</a>
  </div>
</section>
